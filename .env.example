# ---- Azure OpenAI (Microsoft Foundry) ----
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2024-10-21
# deployment names you created in Foundry
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ---- LangSmith tracing / evals ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<key>
LANGSMITH_PROJECT=techcart

# ---- Optional: Azure AI Search as the vector store (default: local numpy store) ----
VECTOR_BACKEND=local            # local | azure_search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=techcart-docs

# ---- Optional: MLflow (Azure ML workspaces expose an MLflow tracking URI) ----
MLFLOW_TRACKING_URI=

# ---- App ----
TECHCART_DATA_DIR=./data
CURRENCY=SAR
# llm = LangGraph + Azure OpenAI ; rules = deterministic fallback agent (no LLM needed)
AGENT_MODE=llm
# inproc = MCP servers run in-memory ; http = connect to MCP servers over streamable HTTP
MCP_MODE=inproc
MCP_INVENTORY_URL=http://localhost:8101/mcp
MCP_PAYMENTS_URL=http://localhost:8102/mcp
MCP_SHIPPING_URL=http://localhost:8103/mcp
